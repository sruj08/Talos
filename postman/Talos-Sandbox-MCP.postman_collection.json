    {
      "name": "04 — JSON-RPC 2.0 MCP Tool Bridge (API-16)",
      "item": [
        {
          "name": "16. Execute JSON-RPC 2.0 MCP Tool Bridge (API-16)",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('API-16 JSON-RPC 2.0 MCP Bridge returns protected PayPal order', function () {",
            "  pm.response.to.have.status(200);",
            "  const body = pm.response.json();",
            "  pm.expect(body.jsonrpc).to.eql('2.0');",
            "  pm.expect(body.result.firewall_clean).to.eql(true);",
            "});"
          ] } }],
          "request": { "method": "POST", "url": "{{GO_ORCHESTRATOR_URL}}/mcp", "header": [{ "key": "Content-Type", "value": "application/json" }, { "key": "traceparent", "value": "{{TRACEPARENT}}" }], "body": { "mode": "raw", "raw": "{\"jsonrpc\":\"2.0\",\"id\":1,\"method\":\"tools/call\",\"params\":{\"name\":\"paypal_create_protected_order\",\"arguments\":{\"sku_query\":\"Shure SM7B Vocal Dynamic Microphone\",\"amount_cents\":24900}}}" } }
