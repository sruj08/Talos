        {
          "name": "7. Query AG Grid Escrow Blotter & Elastic OTel Telemetry (API-12)",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('API-12 Blotter returns summary_metrics and rows', function () {",
