          ] } }],
          "request": { "method": "POST", "url": "{{GO_ORCHESTRATOR_URL}}/api/v1/webhooks/paypal", "header": [{ "key": "Content-Type", "value": "application/json" }, { "key": "traceparent", "value": "{{TRACEPARENT}}" }], "body": { "mode": "raw", "raw": "{\"id\":\"WH-2WR32451HC0233532-67976317FL4543714\",\"event_type\":\"PAYMENT.AUTHORIZATION.CREATED\"}" } }
        },
        {
          "name": "10. Verify SHA-256 Tamper-Evident Audit Hash Chain (API-15)",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('API-15 Audit Chain verification confirms tamper-evident hash chain', function () {",
