      "item": [
        {
          "name": "5. Evaluate Agent Checkout & Place PayPal Sandbox Hold (API-05)",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('API-05 Checkout Evaluate places PayPal Sandbox AUTHORIZE hold', function () {",
            "  pm.expect(pm.response.code).to.be.oneOf([200, 201]);",
            "  const body = pm.response.json();",
            "  pm.expect(body.state).to.eql('PAYPAL_AUTHORIZED');",
            "  pm.expect(body.paypal_order_id).to.be.a('string');",
            "  pm.expect(body.paypal_auth_id).to.be.a('string');",
            "});"
          ] } }],
          "request": { "method": "POST", "url": "{{GO_ORCHESTRATOR_URL}}/api/v1/checkout/evaluate", "header": [{ "key": "Content-Type", "value": "application/json" }, { "key": "PayPal-Request-Id", "value": "newman-smoke-eval-05" }, { "key": "traceparent", "value": "{{TRACEPARENT}}" }], "body": { "mode": "raw", "raw": "{\"mandate_id\":\"{{MANDATE_ID}}\",\"sku_query\":\"Shure SM7B Vocal Dynamic Microphone\",\"category\":\"Studio Audio\",\"merchant_name\":\"AudioPro Verified\",\"merchant_url\":\"https://verified-audio.trychannel3.com/sku/shure-sm7b\",\"amount_cents\":24900,\"max_amount_cents\":30000,\"max_spread_bps\":1500}" } }
        },
        {
          "name": "6. Channel3 Fair-Market Price Benchmark (API-06)",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('API-06 Channel3 Benchmark computes spread_bps within cap', function () {",
            "  pm.response.to.have.status(200);",
            "  const body = pm.response.json();",
            "  pm.expect(body.median_price_cents).to.eql(24900);",
            "  pm.expect(body.gouging_blocked).to.eql(false);",
