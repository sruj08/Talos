{
  "mcpServers": {
    "paypal-sandbox-mcp": {
      "command": "npx",
      "args": [
        "-y",
        "@paypal/agent-toolkit",
        "--all"
      ],
      "env": {
        "PAYPAL_ACCESS_TOKEN": "${PAYPAL_ACCESS_TOKEN}",
        "PAYPAL_ENVIRONMENT": "SANDBOX"
      }
    },
    "talos-firewall-rs": {
      "command": "cargo",
      "args": [
        "run",
        "--manifest-path",
        "services/firewall-rs/Cargo.toml",
        "--",
        "--mcp-stdio"
      ],
      "env": {
        "RUST_LOG": "info"
      }
    },
    "bryntum-docs-mcp": {
      "url": "https://mcp.bryntum.com/mcp"
    },
    "apimatic-paypal-context": {
      "command": "npx",
      "args": [
        "-y",
        "@apimatic/context-mcp",
        "--portal",
        "paypal-server-sdk"
      ],
      "env": {
        "APIMATIC_API_KEY": "${APIMATIC_API_KEY}"
      }
    },
    "channel3-catalog": {
      "command": "npx",
      "args": [
        "-y",
        "@channel3/mcp-server"
      ],
      "env": {
        "CHANNEL3_API_KEY": "${CHANNEL3_API_KEY}"
      }
    }
  }
}