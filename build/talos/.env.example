# ==============================================================================
# TALOS — ENVIRONMENT CONFIGURATION (.env.example)
# Copy to .env and populate secrets using the Safe Credentials Protocol:
#   printf "Enter KEY_NAME (typing hidden): " && read -s val && echo && echo "KEY_NAME=$val" >> ".env"
# Never commit real secrets to Git!
# ==============================================================================

# --- 1. PAYPAL DEVELOPER SANDBOX (See docs/09-integrations-and-guides/01-PAYPAL_SANDBOX_STEP_BY_STEP.md) ---
PAYPAL_ENVIRONMENT=sandbox
PAYPAL_API_BASE_URL=https://api-m.sandbox.paypal.com
PAYPAL_CLIENT_ID=your_paypal_sandbox_client_id_here
PAYPAL_CLIENT_SECRET=your_paypal_sandbox_client_secret_here
PAYPAL_WEBHOOK_ID=your_paypal_sandbox_webhook_id_here
PAYPAL_SANDBOX_BUYER_EMAIL=buyer-talos@personal.example.com
PAYPAL_SANDBOX_MERCHANT_EMAIL=merchant-talos@business.example.com
NEXT_PUBLIC_PAYPAL_CLIENT_ID=your_paypal_sandbox_client_id_here

# --- 2. APIMATIC SDK & CONTEXT PLUGIN (See docs/09-integrations-and-guides/02-APIMATIC_INTEGRATION_GUIDE.md) ---
APIMATIC_API_KEY=your_apimatic_api_key_here
APIMATIC_CONTEXT_PLUGIN_ENABLED=true

# --- 3. AG GRID ENTERPRISE & AG STUDIO (See docs/09-integrations-and-guides/03-AG_GRID_AND_AG_STUDIO_GUIDE.md) ---
NEXT_PUBLIC_AG_GRID_LICENSE_KEY=your_optional_ag_grid_hackathon_trial_key

# --- 4. BRYNTUM SCHEDULER PRO & MCP (See docs/09-integrations-and-guides/04-BRYNTUM_SCHEDULER_AND_GANTT_GUIDE.md) ---
BRYNTUM_MCP_URL=https://mcp.bryntum.com/mcp

# --- 5. CHANNEL3 FAIR-PRICE ORACLE (See docs/09-integrations-and-guides/05-CHANNEL3_INTEGRATION_GUIDE.md) ---
CHANNEL3_API_BASE_URL=https://api.trychannel3.com/v1
CHANNEL3_API_KEY=your_channel3_api_key_here

# --- 6. KERNEL CLOUD BROWSER SANDBOX (See docs/09-integrations-and-guides/09-KERNEL_ASTROPODS_ZAPIER_GUIDE.md) ---
KERNEL_API_BASE_URL=https://api.onkernel.com/v1
KERNEL_API_KEY=your_kernel_cloud_browser_api_key_here

# --- 7. ELASTIC CLOUD OPENTELEMETRY & VECTOR DB (See docs/09-integrations-and-guides/07-ELASTIC_OTEL_AND_VECTOR_GUIDE.md) ---
ELASTIC_OTLP_ENDPOINT=https://your-deployment.apm.us-central1.gcp.cloud.es.io:443
ELASTIC_API_KEY=your_elastic_cloud_api_key_here
ELASTICSEARCH_URL=https://your-deployment.es.us-central1.gcp.cloud.es.io:443

# --- 8. AI AGENT REASONING MODELS (Fallback to Deterministic Demo Mode if unset) ---
ANTHROPIC_API_KEY=your_optional_anthropic_api_key
OPENAI_API_KEY=your_optional_openai_api_key
ONNX_MODEL_PATH=./models/deberta-v3-prompt-injection-int8.onnx

# --- 9. INTERNAL SERVICES, POSTGRESQL 16 & VALKEY/REDIS ---
RUST_FIREWALL_PORT=8081
RUST_FIREWALL_URL=http://localhost:8081
RUST_ED25519_SEED_HEX=0102030405060708090a0b0c0d0e0f101112131415161718191a1b1c1d1e1f20
GO_ORCHESTRATOR_PORT=8080
NEXT_PUBLIC_ORCHESTRATOR_URL=http://localhost:8080
NEXT_PUBLIC_ORCHESTRATOR_WS_URL=ws://localhost:8080/ws/events
NEXT_PUBLIC_FIREWALL_URL=http://localhost:8081
NEXT_PUBLIC_TALOS_SANDBOX_FALLBACK_ENABLED=true
DATABASE_URL=postgres://talos:talos_local_pw@localhost:5432/talos?sslmode=disable
REDIS_URL=redis://localhost:6379/0
TALOS_SANDBOX_FALLBACK_ENABLED=true
